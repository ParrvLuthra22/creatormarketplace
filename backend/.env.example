# ─────────────────────────────────────────────────────────────────────────
# CreatorLyff backend — environment variables
# Copy this file to `.env` and fill in real values. Nothing here is a secret;
# `.env` itself is gitignored and should never be committed.
# ─────────────────────────────────────────────────────────────────────────

# ─── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001

# MongoDB connection string. Either name works — config/db.ts checks
# MONGODB_URI first, then falls back to DATABASE_URL. Pick one.
MONGODB_URI=mongodb://localhost:27017/creatorlyff
# DATABASE_URL=mongodb+srv://user:pass@cluster.mongodb.net/creatorlyff

# Secret used to sign JWT auth cookies. Use a long random string in
# production (e.g. `openssl rand -hex 32`) — never reuse the dev value.
JWT_SECRET=replace-with-a-long-random-string

# The frontend's public origin. Used to build links in transactional emails
# (proposal/verification/password-reset CTAs) and OAuth redirect targets.
FRONTEND_URL=http://localhost:3000

# Comma-separated list of origins the API will accept cookie-credentialed
# requests from. *.vercel.app and *.up.railway.app are always allowed on top
# of this list (see server.ts's CORS config).
CORS_ORIGIN=http://localhost:3000

# Cookie domain for the httpOnly auth cookie (leave unset in local dev).
COOKIE_DOMAIN=localhost

# ─── Cron / scheduled jobs ──────────────────────────────────────────────

# Set to "false" to disable the in-process node-cron social-sync job
# (jobs/socialSync.ts, runs daily at 03:00 UTC). Useful when running multiple
# instances, where you don't want every instance running its own cron.
ENABLE_CRON=true

# Shared secret for machine-triggered endpoints that shouldn't require a
# human admin login — currently GET /api/verification/auto-flag, sent as the
# `X-Cron-Secret` header (see middleware/adminAuth.ts's
# adminOrCronSecretMiddleware). Required if you move the daily sync to an
# external cron provider (Render Cron, GitHub Actions, etc.) instead of
# relying on the in-process node-cron job, since that can't survive multiple
# app instances or serverless deployments. Generate with `openssl rand -hex 32`.
CRON_SECRET=replace-with-a-long-random-string

# Comma-separated emails to grant admin access to via `npm run seed:admin`.
# Each email must already have a CreatorLyff account, or the script will
# offer to create one interactively. See /dashboard/admin/setup in the app.
ADMIN_EMAILS=you@example.com

# ─── Cloudinary (file uploads) ──────────────────────────────────────────
# If unset, uploads fall back to local disk storage under backend/uploads/
# (fine for local dev, not for production/multi-instance deployments).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Resend (transactional email) ───────────────────────────────────────
# If unset, email sends are skipped (logged, not thrown) — see config/email.ts.
RESEND_API_KEY=
EMAIL_FROM=CreatorLyff <notifications@creatorlyff.com>

# ─── PostHog (product analytics) ────────────────────────────────────────
# If unset, trackEvent() calls throughout the app are no-ops.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ─── OAuth — social login & platform data sync ──────────────────────────
# Each provider needs its client id/secret from that platform's developer
# console, plus a callback URL registered there. The *_CALLBACK_URL vars all
# default to http://localhost:5001/api/auth/<provider>/callback if unset —
# only override them for a non-default port or a deployed backend URL.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_CALLBACK_URL=http://localhost:5001/api/auth/instagram/callback
# Meta app secret, used to verify data-deletion request signatures on the
# Instagram deletion-callback endpoint (routes/instagram.ts).
FACEBOOK_APP_SECRET=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_CALLBACK_URL=http://localhost:5001/api/auth/youtube/callback

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_URL=http://localhost:5001/api/auth/twitter/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:5001/api/auth/linkedin/callback

SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_CALLBACK_URL=http://localhost:5001/api/auth/snapchat/callback

# ─── Razorpay (payments) — DISABLED, see config/razorpay.ts ────────────
# CreatorLyff is in a free beta/validation phase and doesn't take payments
# yet. These are read by routes/payments.ts, which is built but intentionally
# left unmounted in server.ts. Filling these in alone does NOT enable
# billing — see config/razorpay.ts's top-of-file comment for the two extra
# steps required. Plan amounts (₹999 basic / ₹2999 pro) already match what's
# shown on the frontend /pricing page.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_BASIC=
RAZORPAY_PLAN_PRO=

# ─── Dev tooling only ────────────────────────────────────────────────────
# Base URL used by scripts/check-public-creators.ts (a manual diagnostic
# script, not part of the running app). Defaults to http://localhost:5001.
# API_BASE_URL=http://localhost:5001
